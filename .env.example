# Copy to .env and fill in. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Needed when the app is opened via another origin, e.g. http://192.168.1.10:8000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Telegram (use a TEST channel and TEST discussion group during development)
TELEGRAM_BOT_TOKEN=123456789:replace-with-token-from-BotFather
# Channel: -100xxxxxxxxxx or @channel_username
TELEGRAM_CHANNEL_ID=-1001234567890
# Linked discussion group (needed to turn comments off). Leave empty to disable.
TELEGRAM_DISCUSSION_GROUP_ID=-1009876543210
# Your private chat id for the "Send test to me" button. Leave empty to hide it.
TELEGRAM_TEST_CHAT_ID=

# Worker
PUBLISHER_INTERVAL_SECONDS=15
# Dashboard highlights products whose price changed more than this % in a week
PRICE_ALERT_PERCENT=10
